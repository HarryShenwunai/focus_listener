<Window x:Class="FocusListener.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Listener"
        Width="430"
        MinHeight="210"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Border Margin="12"
            Padding="22"
            Background="#FBFCFA"
            BorderBrush="#DCE5DE"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18" Color="#142018" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#49A777" Margin="0,0,9,0" />
                    <StackPanel>
                        <TextBlock Text="FOCUS LISTENER" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" CharacterSpacing="90" />
                        <TextBlock x:Name="ModeLabel" Text="模拟课堂 · 小学行程问题" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="—" Click="Minimize_Click" Padding="8,3"
                        Background="Transparent" FontSize="16" ToolTip="最小化" />
                <Button Grid.Column="2" Content="×" Click="Close_Click" Padding="8,3"
                        Background="Transparent" FontSize="18" ToolTip="关闭" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <StackPanel x:Name="StartPanel">
                    <TextBlock Text="在听课途中，轻轻拉回注意力。" FontFamily="Microsoft YaHei UI"
                               FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{StaticResource MutedBrush}"
                               Text="先用内置课堂脚本验证完整流程。自动题只复述知识点，不要求计算；Ctrl + Shift + Q 可手动触发。" />
                    <Button Content="开始 12 分钟模拟课堂" Click="StartSession_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel x:Name="ListeningPanel" Visibility="Collapsed">
                    <TextBlock Text="正在听课" FontSize="25" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="ListeningNotice" Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Text="等待出现合适的知识单元…" />
                    <Button Content="现在问我一道" Click="ManualTrigger_Click"
                            Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel x:Name="QuestionPanel" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="#FFF1CD" CornerRadius="9" Padding="9,4">
                            <TextBlock x:Name="CountdownText" Text="8 秒" Foreground="#7A5716" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="TriggerLabel" Text="自动复位题" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="QuestionStem" Margin="0,12,0,13" TextWrapping="Wrap"
                               FontSize="21" FontWeight="SemiBold" LineHeight="30"
                               Foreground="{StaticResource InkBrush}" />
                    <Button x:Name="ChoiceA" Tag="A" Click="Choice_Click" Margin="0,4" HorizontalContentAlignment="Left" />
                    <Button x:Name="ChoiceB" Tag="B" Click="Choice_Click" Margin="0,4" HorizontalContentAlignment="Left" />
                    <Button x:Name="ChoiceC" Tag="C" Click="Choice_Click" Margin="0,4" HorizontalContentAlignment="Left" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ExtendButton" Content="再想 12 秒" Click="Extend_Click"
                                Background="Transparent" Foreground="{StaticResource AccentBrush}" />
                        <Button x:Name="CollapseButton" Grid.Column="1" Content="稍后再答" Click="CollapsePending_Click"
                                Visibility="Collapsed" Background="Transparent" />
                        <Button Grid.Column="2" Content="题目有误" Click="ReportIssue_Click"
                                Background="Transparent" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PendingPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Button Click="OpenPending_Click" Padding="18,12"
                            Background="#FFF1CD" Foreground="#76520E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Margin="0,0,8,0" />
                            <TextBlock x:Name="PendingText" Text="有 1 道待答题" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="点击徽标继续作答" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="FeedbackPanel" Visibility="Collapsed">
                    <TextBlock x:Name="FeedbackTitle" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="课堂原话" Margin="0,14,0,5" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" />
                    <Border Background="#F0F5F1" CornerRadius="12" Padding="14">
                        <TextBlock x:Name="EvidenceText" TextWrapping="Wrap" LineHeight="23"
                                   Foreground="{StaticResource InkBrush}" />
                    </Border>
                    <TextBlock Text="3 秒后继续监听" Margin="0,10,0,0" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel x:Name="RatingPanel" Visibility="Collapsed">
                    <TextBlock Text="这些问题有多大程度帮你拉回注意力？" TextWrapping="Wrap"
                               FontSize="22" FontWeight="SemiBold" LineHeight="31"
                               Foreground="{StaticResource InkBrush}" />
                    <UniformGrid Columns="5" Margin="0,18,0,10">
                        <Button Content="1" Tag="1" Click="Rating_Click" Margin="3" />
                        <Button Content="2" Tag="2" Click="Rating_Click" Margin="3" />
                        <Button Content="3" Tag="3" Click="Rating_Click" Margin="3" />
                        <Button Content="4" Tag="4" Click="Rating_Click" Margin="3" />
                        <Button Content="5" Tag="5" Click="Rating_Click" Margin="3" />
                    </UniformGrid>
                    <DockPanel>
                        <TextBlock Text="完全没帮助" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBlock Text="非常有帮助" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Button Content="跳过" Click="SkipRating_Click" Margin="0,15,0,0" Background="Transparent" />
                </StackPanel>

                <StackPanel x:Name="CompletedPanel" Visibility="Collapsed">
                    <TextBlock Text="本次课堂已完成" FontSize="25" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="SummaryText" Margin="0,10,0,18" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Content="导出分析 CSV" Click="ExportCsv_Click"
                            Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="SessionFooter" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <Button x:Name="EndButton" Grid.Column="1" Content="结束课堂" Click="EndSession_Click"
                        Padding="10,5" Background="Transparent" Foreground="#8B4A45" />
            </Grid>
        </Grid>
    </Border>
</Window>
